# 本地 SQLite 无需安装数据库；Docker Compose 会覆盖为 PostgreSQL。
DATABASE_URL=sqlite:///./data/training.db
# 数据目录，存放 SQLite 文件和上传的视频；必须备份。
DATA_DIR=./data
# 首次启动自动创建此管理员；创建后修改此处不会重置数据库中的密码。
ADMIN_USERNAME=admin
# 请替换为自己的至少 12 位密码，不要把真实 .env 提交到 GitHub。
ADMIN_PASSWORD=CHANGE_ME_before_start
# 本机 HTTP 调试用 false；通过 HTTPS 对外提供服务时必须改成 true。
COOKIE_SECURE=false
# 登录会话有效期，单位小时。
SESSION_HOURS=12
# 单个视频大小限制，单位 MB；反向代理也需要配置对应上传上限。
MAX_UPLOAD_MB=500
# 仅 Docker Compose 初始化 PostgreSQL 时使用；替换为随机字母数字密码。
POSTGRES_PASSWORD=CHANGE_ME_database_password
