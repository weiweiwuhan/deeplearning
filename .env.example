# ---------- 应用 ----------
# 应用名称，用于系统标识。
APP_NAME=training-system
# 应用版本号。
APP_VERSION=0.1.0
# 开启开发调试；生产环境应关闭。
DEBUG=true

# ---------- 数据库 ----------
# 本机直跑用 localhost；docker-compose 里 api 服务会覆盖成 postgres
# PostgreSQL 连接地址：驱动、开发用户名和密码、主机、端口及数据库名；容器中由 Compose 覆盖。
DATABASE_URL=postgresql+psycopg://training:training@localhost:5432/training
# 是否输出 SQL 日志，false 表示关闭。
DB_ECHO=false

# ---------- Redis ----------
# Redis 地址，使用本机 6379 端口的第 0 个逻辑数据库。
REDIS_URL=redis://localhost:6379/0

# ---------- 鉴权 ----------
# 生产环境必须换：openssl rand -hex 32
# JWT 签名示例密钥；仅用于开发，部署前替换为随机密钥。
JWT_SECRET=dev-only-change-me
# JWT 使用 HS256 对称签名算法。
JWT_ALGORITHM=HS256
# 登录令牌有效期，单位分钟；10080 分钟等于 7 天。
JWT_EXPIRE_MINUTES=10080
# 绑定凭据有效期，单位分钟。
BIND_TICKET_EXPIRE_MINUTES=10
# 后台会话签名示例密钥；部署前独立生成并保持稳定。
SESSION_SECRET=dev-only-change-me-too

# ---------- 微信小程序 ----------
# 没拿到 AppID 之前保持 WECHAT_MOCK=true，本地可完整联调
# 微信小程序 AppID；接入真实微信时填写。
WX_APPID=
# 微信小程序密钥占位；不要将真实密钥提交到 Git。
WX_SECRET=
# 启用微信模拟登录；生产环境必须关闭。
WECHAT_MOCK=true

# ---------- 后台 ----------
# 后台管理员用户名。
ADMIN_USERNAME=admin
# 开发用管理员密码，部署前必须修改。
ADMIN_PASSWORD=admin123
# 后台管理类 API 的临时密钥，第 2 周会换成 JWT + 角色
# 管理接口开发密钥；部署前必须修改。
ADMIN_API_KEY=dev-admin-key

# ---------- CORS ----------
# 允许的跨域来源；星号表示全部来源，生产环境应限制为实际前端域名。
CORS_ORIGINS=*
